{
  "name": "numarataj-filo",
  "version": "1.0.0",
  "description": "Numarataj Şube Müdürlüğü Araç Filo Yönetim Sistemi",
  "author": "Burak Tonoz",
  "main": "main.js",
  "scripts": {
    "build-css": "npx tailwindcss -i ./src/input.css -o ./style.css --minify",
    "start": "npm run build-css && electron .",
    "build": "npm run build-css && electron-builder --win"
  },
  "build": {
    "appId": "com.buraktonoz.numarataj",
    "productName": "Numarataj Filo",
    "copyright": "Copyright © 2026 Burak Tonoz",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "Numarataj_Filo_Portable.exe"
    }
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}
